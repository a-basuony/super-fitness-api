# Application Configuration
PORT=3000
NODE_ENV=production

# Database Configuration (PostgreSQL)
DATABASE_HOST=postgres-db
DATABASE_PORT=5432
DATABASE_USER=fitness-app
DATABASE_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DATABASE_NAME=fitness-app

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# JWT Configuration (minimum 32 characters each)
JWT_ACCESS_SECRET=CHANGE_THIS_JWT_ACCESS_SECRET_MINIMUM_32_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_THIS_JWT_REFRESH_SECRET_MINIMUM_32_CHARACTERS

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_smtp_username@gmail.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=noreply@your-domain.com

# Google AI Configuration
GOOGLE_API_KEY=your_google_api_key

# Application URL
APP_URL=https://api.your-domain.com

# Docker-specific
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest